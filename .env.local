# Local overrides loaded by deploy-local.sh
COMPOSE_PROJECT_NAME=some-kind-of-irc
MEDIA_STORAGE_URL=http://media-storage:9101
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:8080/minio
MINIO_BUCKET=media
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
BACKEND_VERIFY_URL=http://backend:8002/auth/me
PUBLIC_BASE_URL=http://localhost:9101
DATA_PROCESSOR_URL=http://data-processor:8003
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:4269,http://127.0.0.1:4269,http://localhost:8080,http://127.0.0.1:8080
FEATURE_DATA_PROCESSOR=true
AI_RATE_LIMIT_PER_HOUR=100
# ANTHROPIC_API_KEY - pass via command line: ANTHROPIC_API_KEY=sk-ant-... ./deploy-local.sh
DB_HOST=postgres
DB_PORT=5432
DB_NAME=app_db
DB_USER=app_user
DP_SERVICE_AUTH_SECRET="dev-secret"

# Gmail OAuth (from secrets/client_secret_841892576231-67tqnccidmvmr3dfspqbghdjdaup8bvs.apps.googleusercontent.com.json)
GMAIL_OAUTH_CLIENT_ID=841892576231-67tqnccidmvmr3dfspqbghdjdaup8bvs.apps.googleusercontent.com
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URL=http://localhost:8002/api/auth/callback
GMAIL_OAUTH_SCOPES="https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/calendar"

# Keep allowlists explicit locally
ADMIN_ALLOWLIST="admina;guest;guest2"
AI_ALLOWLIST="admina;guest;guest2;guest3"
